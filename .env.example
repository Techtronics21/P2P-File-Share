# How to use:
# 1. Copy this file (paste below code onto your terminal in the project root):
    cp .env.example .env
# 2. Edit .env with your AWS credentials if you want to use S3 mode (optional, socket P2P mode works without this)
# 3. replace "<YOUR_IP_HERE>" with your machine's LAN IP

# AWS S3 Configuration

# AWS Credentials (get from AWS IAM console)
export AWS_ACCESS_KEY_ID=your-access-key-here
export AWS_SECRET_ACCESS_KEY=your-secret-key-here

# AWS Region (default: us-east-1)
export AWS_REGION=us-east-1

# S3 Bucket Name (create this bucket in AWS first)
export S3_BUCKET_NAME=peerlink-file-storage

NEXT_PUBLIC_API_URL=http://<YOUR_IP_HERE>:8080



